Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

m_task.settask("torch.infer.mobilevit.detection");
m_task.setcase("T_torch_detection_cpu");
m_task.setmodel(global_torch_model_path);
m_task.setinputpath(global_torch_input_image);
m_task.setdevice("cpu");
m_task.settimeout(30000);

m_task.run(m_image);

global_torch_ok = m_task.getok();
global_torch_result_count = m_task.getresultcount();
global_torch_infer_ms = m_task.getinferms();
global_current_status = m_task.getstatus();