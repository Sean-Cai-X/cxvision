Image m_image;
TorchTask m_task;

m_image.copyFromMat(global_matInput);

m_task.settask("torch.infer.detection.yolov8.v1");
m_task.setcase("T_torch_detection_yolov8_cpu_smoke");
m_task.setmanifest("libtorch_module/testdata/manifests/yolov8_cpu_v1.json");
m_task.setinputpath("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/test_images/L2_low_contrast_illumination/fastmatch_bottle_test_l2.jpg");
m_task.setoutputdir("D:/Codex-WorkDir/Sean_WorkDir/cxvisionai/cxscript_runs/headless/T6_torch_detection_yolov8_cpu_smoke");
m_task.setdevice("cpu");
m_task.settimeout(30000);

m_task.run(m_image);

global_headless_ok = m_task.getok();
global_torch_ok = m_task.getok();
global_torch_result_count = m_task.getresultcount();
global_torch_infer_ms = m_task.getinferms();
