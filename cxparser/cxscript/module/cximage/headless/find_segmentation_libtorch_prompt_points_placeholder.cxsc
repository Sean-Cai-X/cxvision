Image m_image;
FindSegmentation m_seg;

m_image.copyFromMat(global_matInput);

int x0 = global_roi_x0;
int y0 = global_roi_y0;
int x1 = global_roi_x1;
int y1 = global_roi_y1;

int positive_x = 320;
int positive_y = 240;
int negative_x = 96;
int negative_y = 96;
int positive_count = 1;
int negative_count = 1;
int prompt_points_binding_ready = 0;
double threshold = 0.5;

int prompt_x0 = 120;
int prompt_y0 = 120;
int prompt_x1 = 980;
int prompt_y1 = 820;

if (x1 > x0)
{
if (y1 > y0)
{
prompt_x0 = x0;
prompt_y0 = y0;
prompt_x1 = x1;
prompt_y1 = y1;
}
}

m_seg.setbackend("libtorch_segmentation");
m_seg.setdevice("cpu");
m_seg.setmodel("");
m_seg.setthreshold(threshold);
m_seg.setpromptrect(prompt_y1, prompt_x1, prompt_y0, prompt_x0);

m_seg.setpoint(positive_x, positive_y);
m_seg.setmode(3);

m_seg.segment(&m_image);
m_seg.extractboundary();
m_seg.buildoverlay(&m_image);
