CxShapeTest_reset(0);

CxShapeTest_addcase("ellipse_drag_center");
CxShapeTest_settool("ellipse_manual");
CxShapeTest_setoperation("drag_handle");
CxShapeTest_setinitialellipse(200, 180, 80, 40);
CxShapeTest_sethandle("Center");
CxShapeTest_setfrom(200, 180);
CxShapeTest_setto(240, 210);
CxShapeTest_setexpected("ellipse_translate_only");

