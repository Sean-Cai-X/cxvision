Image m_image;
Findline m_line;

m_image.copyFromMat(global.matInput);

int x0 = 120;
int y0 = 240;
int x1 = 980;
int y1 = 240;
int scale = 1;
int method = 0;
int threshold = 20;
int linegap = 3;
int fitmode = 1;

m_line.setline(x0, y0, x1, y1, scale);
m_line.setmethod(method);
m_line.setthre(threshold);
m_line.setlinegap(linegap);
m_line.setfitmode(fitmode);
m_line.measure(&m_image);
m_line.fitline();

global.line_ref = m_line.get_result();
global.current_status = "PENDING";
