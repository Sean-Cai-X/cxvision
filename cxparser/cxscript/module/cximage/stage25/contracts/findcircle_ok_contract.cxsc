global.contract_pass = 1;
global.contract_status = "findcircle_ok_passed";
global.contract_conclusion = "Findcircle OK: circle points and fitted circle are available.";

if (global.headless_ok == 0) {
    global.contract_pass = 0;
    global.contract_status = "findcircle_ok_failed";
    global.contract_conclusion = "Headless execution failed";
}

if (global.valid_points_count < 3) {
    global.contract_pass = 0;
    global.contract_status = "findcircle_ok_failed";
    global.contract_conclusion = "Findcircle OK requires valid_points_count >= 3";
}

if (global.has_fit_circle == 0) {
    global.contract_pass = 0;
    global.contract_status = "findcircle_ok_failed";
    global.contract_conclusion = "Findcircle OK requires has_fit_circle == true";
}

if (global.circle_radius <= 0) {
    global.contract_pass = 0;
    global.contract_status = "findcircle_ok_failed";
    global.contract_conclusion = "Findcircle OK requires circle_radius > 0";
}

if (global.policy_guard_match == 0) {
    global.contract_pass = 0;
    global.contract_status = "findcircle_ok_failed";
    global.contract_conclusion = "Findcircle OK requires CIRCLE_MEASURE_AND_FIT_AVAILABLE";
}
