global.contract_pass = 1;
global.contract_status = "findline_ok_passed";
global.contract_conclusion = "Findline OK: points and fitted line are available.";

if (global.headless_ok == 0) {
    global.contract_pass = 0;
    global.contract_status = "findline_ok_failed";
    global.contract_conclusion = "Headless execution failed";
}

if (global.valid_points_count < 2) {
    global.contract_pass = 0;
    global.contract_status = "findline_ok_failed";
    global.contract_conclusion = "Findline OK requires valid_points_count >= 2";
}

if (global.has_fit_line == 0) {
    global.contract_pass = 0;
    global.contract_status = "findline_ok_failed";
    global.contract_conclusion = "Findline OK requires has_fit_line == true";
}

if (global.policy_guard_match == 0) {
    global.contract_pass = 0;
    global.contract_status = "findline_ok_failed";
    global.contract_conclusion = "Findline OK requires MEASURE_AND_FIT_AVAILABLE";
}
