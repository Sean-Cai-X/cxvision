CxParameterProfile_reset(0);
CxParameterProfile_settool("Findline");

CxParameterProfile_add("findline_stage25_filter20");
CxParameterProfile_setrole("BASELINE_OK");
CxParameterProfile_setmethod(0);
CxParameterProfile_setthreshold(20);
CxParameterProfile_setlinegap(6);
CxParameterProfile_setwgap(32);
CxParameterProfile_sethgap(8);
CxParameterProfile_setfilterprofile(1);
CxParameterProfile_setdescription("Baseline Findline profile from verified Stage25 filter20 case.");

