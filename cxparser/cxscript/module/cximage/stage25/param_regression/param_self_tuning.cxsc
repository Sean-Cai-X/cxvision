// Stage25 自整定脚本
// 不修改 C++ 代码，通过 cxscript 实现 Gauge 区域扫描 + 参数网格化搜索 + 闭环反馈
// 流程: Phase1 Gauge扫描 → Phase2 参数搜索 → Phase3 闭环迭代

ParamRegressionTask_reset(0);
ParamRegressionTask_setid("self_tuning_findline_l1_l3");
ParamRegressionTask_settool("Findline");
ParamRegressionTask_setmaxcandidates(100);
ParamRegressionTask_setmaxcaseseconds(10);
ParamRegressionTask_setmaxtotalseconds(600);
ParamRegressionTask_enablemlpackrank(0);
ParamRegressionTask_enableensmallenopt(0);
ParamRegressionTask_setpromotionallowed(0);

global_self_tuning_phase = "phase1_gauge_scan";
global_self_tuning_status = "initialized";

// ==============================================
// Phase 1: Gauge 区域自适应定位
// ==============================================

global_gauge_scan_base_y0 = global_roi_y0;
global_gauge_scan_base_y1 = global_roi_y1;
global_gauge_scan_range = 50;
global_gauge_scan_step = 5;
global_gauge_scan_best_y = global_roi_y0;
global_gauge_scan_best_points = 0;
global_gauge_scan_best_support = 0.0;
global_gauge_scan_best_fit = false;

for (global_gauge_scan_offset = -global_gauge_scan_range; global_gauge_scan_offset <= global_gauge_scan_range; global_gauge_scan_offset = global_gauge_scan_offset + global_gauge_scan_step)
{
    global_roi_y0 = global_gauge_scan_base_y0 + global_gauge_scan_offset;
    global_roi_y1 = global_gauge_scan_base_y1 + global_gauge_scan_offset;

    if (global_roi_y0 < 0) global_roi_y0 = 0;
    if (global_roi_y1 < 0) global_roi_y1 = 0;

    Image m_image_p1;
    Findline m_line_p1;
    m_image_p1.copyFromMat(global_matInput);

    m_line_p1.SetWHgap(global_candidate_wgap, global_candidate_hgap);
    m_line_p1.setlinegap(global_candidate_linegap);
    m_line_p1.setline(global_roi_x0, global_roi_y0, global_roi_x1, global_roi_y1, global_tool_half_width);
    m_line_p1.setmethod(global_candidate_method);
    m_line_p1.setthre(global_candidate_threshold);
    m_line_p1.setfilterprofile(global_candidate_filterprofile);

    m_line_p1.measure(&m_image_p1);
    m_line_p1.fitline();

    global_gauge_scan_current_points = m_line_p1.get_valid_points_count();
    global_gauge_scan_current_support = m_line_p1.get_local_support();
    global_gauge_scan_current_fit = m_line_p1.has_fit_line();

    if (global_gauge_scan_current_points > global_gauge_scan_best_points)
    {
        global_gauge_scan_best_points = global_gauge_scan_current_points;
        global_gauge_scan_best_y = global_roi_y0;
        global_gauge_scan_best_support = global_gauge_scan_current_support;
        global_gauge_scan_best_fit = global_gauge_scan_current_fit;
    }
}

global_roi_y0 = global_gauge_scan_best_y;
global_roi_y1 = global_gauge_scan_best_y;

global_self_tuning_status = "phase1_complete";
global_self_tuning_gauge_y = global_gauge_scan_best_y;
global_self_tuning_gauge_points = global_gauge_scan_best_points;

// ==============================================
// Phase 2: 参数空间网格化搜索
// ==============================================

global_param_search_best_threshold = global_candidate_threshold;
global_param_search_best_wgap = global_candidate_wgap;
global_param_search_best_hgap = global_candidate_hgap;
global_param_search_best_linegap = global_candidate_linegap;
global_param_search_best_filterprofile = global_candidate_filterprofile;
global_param_search_best_points = 0;
global_param_search_best_support = 0.0;
global_param_search_best_fit = false;

global_threshold_min = 5;
global_threshold_max = 30;
global_threshold_step = 5;

global_wgap_min = 5;
global_wgap_max = 20;
global_wgap_step = 3;

global_hgap_min = 10;
global_hgap_max = 60;
global_hgap_step = 10;

global_linegap_min = 3;
global_linegap_max = 15;
global_linegap_step = 3;

for (global_param_threshold = global_threshold_min; global_param_threshold <= global_threshold_max; global_param_threshold = global_param_threshold + global_threshold_step)
{
    for (global_param_wgap = global_wgap_min; global_param_wgap <= global_wgap_max; global_param_wgap = global_param_wgap + global_wgap_step)
    {
        for (global_param_hgap = global_hgap_min; global_param_hgap <= global_hgap_max; global_param_hgap = global_param_hgap + global_hgap_step)
        {
            for (global_param_linegap = global_linegap_min; global_param_linegap <= global_linegap_max; global_param_linegap = global_param_linegap + global_linegap_step)
            {
                for (global_param_filterprofile = 0; global_param_filterprofile <= 3; global_param_filterprofile = global_param_filterprofile + 1)
                {
                    Image m_image_p2;
                    Findline m_line_p2;
                    m_image_p2.copyFromMat(global_matInput);

                    m_line_p2.SetWHgap(global_param_wgap, global_param_hgap);
                    m_line_p2.setlinegap(global_param_linegap);
                    m_line_p2.setline(global_roi_x0, global_roi_y0, global_roi_x1, global_roi_y1, global_tool_half_width);
                    m_line_p2.setmethod(global_candidate_method);
                    m_line_p2.setthre(global_param_threshold);
                    m_line_p2.setfilterprofile(global_param_filterprofile);

                    m_line_p2.measure(&m_image_p2);
                    m_line_p2.fitline();

                    global_param_current_points = m_line_p2.get_valid_points_count();
                    global_param_current_support = m_line_p2.get_local_support();
                    global_param_current_fit = m_line_p2.has_fit_line();

                    if (global_param_current_points > 0)
                    {
                        global_param_score = global_param_current_points;
                        if (global_param_current_fit) global_param_score = global_param_score + 10;
                        global_param_score = global_param_score * (1.0 + global_param_current_support);

                        if (global_param_score > global_param_search_best_points)
                        {
                            global_param_search_best_threshold = global_param_threshold;
                            global_param_search_best_wgap = global_param_wgap;
                            global_param_search_best_hgap = global_param_hgap;
                            global_param_search_best_linegap = global_param_linegap;
                            global_param_search_best_filterprofile = global_param_filterprofile;
                            global_param_search_best_points = global_param_current_points;
                            global_param_search_best_support = global_param_current_support;
                            global_param_search_best_fit = global_param_current_fit;
                        }
                    }
                }
            }
        }
    }
}

global_candidate_threshold = global_param_search_best_threshold;
global_candidate_wgap = global_param_search_best_wgap;
global_candidate_hgap = global_param_search_best_hgap;
global_candidate_linegap = global_param_search_best_linegap;
global_candidate_filterprofile = global_param_search_best_filterprofile;

global_self_tuning_status = "phase2_complete";

// ==============================================
// Phase 3: 闭环迭代与收敛判定
// ==============================================

global_iteration_count = 0;
global_max_iterations = 5;
global_converged = false;
global_last_points = 0;
global_stable_count = 0;

while (global_iteration_count < global_max_iterations && !global_converged)
{
    global_iteration_count = global_iteration_count + 1;

    Image m_image_p3;
    Findline m_line_p3;
    m_image_p3.copyFromMat(global_matInput);

    m_line_p3.SetWHgap(global_candidate_wgap, global_candidate_hgap);
    m_line_p3.setlinegap(global_candidate_linegap);
    m_line_p3.setline(global_roi_x0, global_roi_y0, global_roi_x1, global_roi_y1, global_tool_half_width);
    m_line_p3.setmethod(global_candidate_method);
    m_line_p3.setthre(global_candidate_threshold);
    m_line_p3.setfilterprofile(global_candidate_filterprofile);

    m_line_p3.measure(&m_image_p3);
    m_line_p3.fitline();

    global_iter_points = m_line_p3.get_valid_points_count();
    global_iter_support = m_line_p3.get_local_support();
    global_iter_fit = m_line_p3.has_fit_line();

    if (global_iter_points == global_last_points)
    {
        global_stable_count = global_stable_count + 1;
    }
    else
    {
        global_stable_count = 0;
    }
    global_last_points = global_iter_points;

    if (global_stable_count >= 3)
    {
        global_converged = true;
    }

    if (!global_converged)
    {
        if (global_iter_points < 2)
        {
            global_candidate_hgap = global_candidate_hgap + 10;
            if (global_candidate_threshold > 5) global_candidate_threshold = global_candidate_threshold - 5;
        }
        else if (global_iter_points > 50)
        {
            if (global_candidate_hgap > 10) global_candidate_hgap = global_candidate_hgap - 10;
            if (global_candidate_threshold < 30) global_candidate_threshold = global_candidate_threshold + 5;
        }

        if (global_iter_support < 0.5)
        {
            global_roi_y0 = global_roi_y0 + 2;
            global_roi_y1 = global_roi_y1 + 2;
        }

        if (!global_iter_fit && global_candidate_linegap < 15)
        {
            global_candidate_linegap = global_candidate_linegap + 2;
        }
    }
}

global_self_tuning_status = "phase3_complete";
global_self_tuning_converged = global_converged;
global_self_tuning_iterations = global_iteration_count;

// ==============================================
// 最终执行与结果输出
// ==============================================

Image m_image;
Findline m_line;

m_image.copyFromMat(global_matInput);

int x0 = global_roi_x0;
int y0 = global_roi_y0;
int x1 = global_roi_x1;
int y1 = global_roi_y1;

int tool_half_width = global_tool_half_width;
int wgap = global_candidate_wgap;
int hgap = global_candidate_hgap;
int linegap = global_candidate_linegap;
int threshold = global_candidate_threshold;
int method = global_candidate_method;
int filterprofile = global_candidate_filterprofile;

m_line.SetWHgap(wgap, hgap);
m_line.setlinegap(linegap);
m_line.setline(x0, y0, x1, y1, tool_half_width);
m_line.setmethod(method);
m_line.setthre(threshold);
m_line.setfilterprofile(filterprofile);

m_line.measure(&m_image);
m_line.fitline();

global_line_ref = m_line.get_result();
global_current_status = "param_self_tuning_complete";

global_self_tuning_final_points = m_line.get_valid_points_count();
global_self_tuning_final_fit = m_line.has_fit_line();
global_self_tuning_final_support = m_line.get_local_support();
global_self_tuning_final_quality = m_line.get_quality();

global_self_tuning_report = "Self-Tuning Complete\n";
global_self_tuning_report = global_self_tuning_report + "=== Phase 1: Gauge Scan ===\n";
global_self_tuning_report = global_self_tuning_report + "Base Y: " + global_gauge_scan_base_y0 + "\n";
global_self_tuning_report = global_self_tuning_report + "Best Y: " + global_gauge_scan_best_y + "\n";
global_self_tuning_report = global_self_tuning_report + "Best Points: " + global_gauge_scan_best_points + "\n";
global_self_tuning_report = global_self_tuning_report + "=== Phase 2: Param Search ===\n";
global_self_tuning_report = global_self_tuning_report + "Threshold: " + global_param_search_best_threshold + "\n";
global_self_tuning_report = global_self_tuning_report + "Wgap: " + global_param_search_best_wgap + "\n";
global_self_tuning_report = global_self_tuning_report + "Hgap: " + global_param_search_best_hgap + "\n";
global_self_tuning_report = global_self_tuning_report + "Linegap: " + global_param_search_best_linegap + "\n";
global_self_tuning_report = global_self_tuning_report + "FilterProfile: " + global_param_search_best_filterprofile + "\n";
global_self_tuning_report = global_self_tuning_report + "=== Phase 3: Iteration ===\n";
global_self_tuning_report = global_self_tuning_report + "Iterations: " + global_iteration_count + "\n";
global_self_tuning_report = global_self_tuning_report + "Converged: " + (global_converged ? "yes" : "no") + "\n";
global_self_tuning_report = global_self_tuning_report + "=== Final Result ===\n";
global_self_tuning_report = global_self_tuning_report + "Points: " + global_self_tuning_final_points + "\n";
global_self_tuning_report = global_self_tuning_report + "Fit: " + (global_self_tuning_final_fit ? "yes" : "no") + "\n";
global_self_tuning_report = global_self_tuning_report + "Support: " + global_self_tuning_final_support + "\n";
global_self_tuning_report = global_self_tuning_report + "Quality: " + global_self_tuning_final_quality + "\n";