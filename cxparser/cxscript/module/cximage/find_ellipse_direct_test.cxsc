Image m_image;
Findellipse m_ellipse;

m_image.copyFromMat(global.matInput);

int x0 = global.ellipse_x0;
int y0 = global.ellipse_y0;
int x1 = global.ellipse_x1;
int y1 = global.ellipse_y1;

int gap = global.gap;
int linegap = global.linegap;
int threshold = global.threshold;
int method = global.method;

m_ellipse.setellipse(x0, y0, x1, y1);
m_ellipse.setgap(gap);
m_ellipse.setlinegap(linegap);
m_ellipse.setthre(threshold);
m_ellipse.setmethod(method);

m_ellipse.measure(&m_image);

global.current_status = "PENDING";

1+1;