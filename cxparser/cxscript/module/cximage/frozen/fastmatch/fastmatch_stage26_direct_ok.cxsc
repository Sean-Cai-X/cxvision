Image m_image;
FastMatch m_match;

m_image.copyFromMat(global_matInput);

int learn_x = global_learn_roi_x;
int learn_y = global_learn_roi_y;
int learn_w = global_learn_roi_w;
int learn_h = global_learn_roi_h;

int search_x = global_search_roi_x;
int search_y = global_search_roi_y;
int search_w = global_search_roi_w;
int search_h = global_search_roi_h;

int threshold = global_threshold;
int linegap = global_linegap;
int wgap = global_wgap;
int hgap = global_hgap;
int compare_gap = global_compare_gap;
int objfilter = global_objfilter;
double min_score = global_min_score;
int find_num = global_find_num;

m_match.setrect(learn_x, learn_y, learn_w, learn_h);
m_match.setobjfilter(objfilter);
m_match.setwhgap(wgap, hgap);
m_match.setthre(threshold);
m_match.setlinegap(linegap);
m_match.setcompgap(compare_gap);
m_match.learn(&m_image);
m_match.modelzero();
m_match.pattern2org();
m_match.samplemodel(100);

m_match.setmatchrect(search_x, search_y, search_w, search_h);
m_match.matchstepgap(10, 10);
m_match.setmatchthre(10);
m_match.setminscore(min_score);
m_match.setfindnum(find_num);
m_match.match(&m_image);

global_learn_a_count = m_match.getlearnacount();
global_learn_b_count = m_match.getlearnbcount();
global_learn_a2_count = m_match.getlearna2count();
global_learn_b2_count = m_match.getlearnb2count();
global_match_count = m_match.getresultcandidatecount();
global_best_score = m_match.getresultbestscore();
global_model_point_count = m_match.getmodelpointcount();
