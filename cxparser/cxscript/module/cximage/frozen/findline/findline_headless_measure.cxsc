Image m_image;
Findline m_line;

m_image.copyFromMat(global_matInput);

m_line.setmaxelapsedms(global_max_elapsed_ms);
m_line.setmaxscanlines(global_max_scan_lines);
m_line.setmaxsamples(global_max_samples);

m_line.SetWHgap(32, 8);
m_line.setlinegap(8);
m_line.setline(100, 100, 300, 300, 10);
m_line.setmethod(2);
m_line.setthre(20);
m_line.setfilterprofile(0);

m_line.measure(&m_image);
m_line.fitline();