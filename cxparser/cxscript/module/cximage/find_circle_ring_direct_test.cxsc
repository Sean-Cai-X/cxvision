Image m_image;
Findcircle m_circle;

m_image.copyFromMat(global_matInput);

int cx = 765;
int cy = 471;
int inner = 0;
int radius = 477;
int circleGap = 80;

int method = 0;
int threshold = 20;
int gap = 5;
int linegap = 3;
int fitMeasureGap = 80;

m_circle.setcircle(cx, cy, inner, radius);
m_circle.setcirclegap(circleGap);
m_circle.setmethod(method);
m_circle.Setgap(gap);
m_circle.setthre(threshold);
m_circle.setlinegap(linegap);
m_circle.setfitmeasuregap(fitMeasureGap);

m_circle.measure(&m_image);
m_circle.fitcircle();
m_circle.FitResultMeasure(&m_image);

global_circle_ref = m_circle.get_result();
global_current_status = "PENDING";
